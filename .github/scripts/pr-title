#!/usr/bin/env bash
# Usage: pr-title "<pull request title>"
# Exits 0 when the title is a Conventional Commit header, 1 otherwise.
set -euo pipefail

types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
pattern="^($types)(\([a-z0-9][a-z0-9._/-]*\))?!?: [^[:space:]].*$"

title="${1-}"
if [[ "$title" =~ $pattern ]]; then
  echo "ok: $title"
  exit 0
fi

cat >&2 <<MSG
The pull request title is not a Conventional Commit: "$title"
Expected: <type>(<scope>)!: <subject>
  type     one of ${types//|/, }
  scope    optional, lower case, in parentheses
  !        optional, marks a breaking change
  subject  a sentence after ": ", not empty
The squash commit takes this title, and the release is versioned from its type.
MSG
exit 1
