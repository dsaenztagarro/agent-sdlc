#!/usr/bin/env bash
#
# serve — browse every page of this design repository at http://localhost:${PORT:-8000}/.
#
# A page opened from file:// has a null origin, so one that fetches anything is blocked; served
# from localhost it behaves as it does in Claude Design. The root is a directory listing.
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
exec python3 -m http.server "${1:-${PORT:-8000}}" --bind 127.0.0.1 --directory "$repo_root"
