#!/usr/bin/env ruby
# frozen_string_literal: true

# stand-ins — where each STAND-IN in pages/ is on its way into the shared design system.
#
# A stand-in is a block this project draws until the shared system draws it, under a marker
# comment: `STAND-IN — delete when the design system lands <Component>`. A marker without that
# clause still counts, but nothing can be looked up by name, so it is judged by its classes alone.
#
# Its stage is read from what exists, never from a list kept by hand:
#   unrequested  no open brief in the shared system's briefs/proposed/ names it
#   requested    an open brief names it, and the shared system does not carry it yet
#   upstream     the shared system carries it, and this project's _ds/ copy does not
#   landed       the _ds/ copy carries it: the stand-in can be deleted
# A system carries it when its manifest lists the component and its CSS defines every class the
# stand-in's rules name. The classes catch a stand-in that extends a component already listed.
#
# Usage:
#   bin/stand-ins [SHARED_CHECKOUT]    default: $__SHARED_VAR__, else __SHARED_CHECKOUT__
#
# Exit 0 when every stand-in is requested and waiting, 1 when one needs a step taken.

require "json"

MARKER = /STAND-IN\s+—\s*(?<text>.*?)\s*(?:\*\/|-->|$)/
NAMED = /lands\s+(?<name>[A-Z][A-Za-z0-9]*)/
CLASS = /\.(-?[_a-zA-Z][\w-]*)/

root = File.expand_path("..", __dir__)
shared = ARGV.fetch(0) { ENV.fetch("__SHARED_VAR__", File.expand_path("__SHARED_CHECKOUT__", root)) }

copies = Dir.glob(File.join(root, "pages/_ds/*/"))
abort "error: no pages/_ds/<id>/ — mirror a project export with bin/sync first." if copies.empty?
abort "error: more than one design-system copy under pages/_ds/: #{copies.join(', ')}" if copies.size > 1
abort "error: no #{shared}/system/ — pass the shared system's checkout: bin/stand-ins <path>" unless File.directory?(File.join(shared, "system"))

System = Struct.new(:components, :css) do
  def self.read(dir)
    manifest = File.join(dir, "_ds_manifest.json")
    components = File.file?(manifest) ? JSON.parse(File.read(manifest)).fetch("components", []).map { |c| c.fetch("name") } : []
    new(components, Dir.glob(File.join(dir, "**/*.css")).map { |path| File.read(path) }.join("\n"))
  end

  def defines?(klass)
    css.match?(/\.#{Regexp.escape(klass)}(?![\w-])/)
  end

  def carries?(stand_in)
    return false if stand_in.name && !components.include?(stand_in.name)
    return false if stand_in.name.nil? && stand_in.classes.empty?

    stand_in.classes.all? { |klass| defines?(klass) }
  end
end

StandIn = Struct.new(:path, :line, :text, :name, :classes)

# The rules after a marker, up to a blank line, the next comment at the start of a line, or the end.
def rules_after(lines, index)
  lines.drop(index + 1).take_while { |line| !line.strip.empty? && !line.start_with?("/*") }
end

# Read as one text, since a selector list is often split across lines ahead of its brace.
def classes_in(rules)
  rules.join.scan(/([^{}]+)\{/).flatten.reject { |selector| selector.strip.start_with?("@") }
       .flat_map { |selector| selector.scan(CLASS).flatten }.uniq
end

stand_ins = Dir.glob(File.join(root, "pages/**/*.{css,js,jsx,html}")).reject { |path| path.include?("/_ds/") }.sort.flat_map do |path|
  lines = File.readlines(path)
  lines.each_index.filter_map do |index|
    match = lines[index].match(MARKER) or next
    css = path.end_with?(".css")
    StandIn.new(path.delete_prefix("#{root}/"), index + 1, match[:text], match[:text][NAMED, :name],
                css ? classes_in(rules_after(lines, index)) : [])
  end
end

if stand_ins.empty?
  puts "none: pages/ holds no STAND-IN"
  exit 0
end

copy = System.read(copies.first)
upstream = System.read(File.join(shared, "system"))
# One open brief per theme: a request is open while one of them asks for the component, in a
# heading or on its Produces line. A name mentioned in passing asks for nothing.
asks = Dir.glob(File.join(shared, "briefs/proposed/*.brief.md")).flat_map do |path|
  File.readlines(path).grep(/\A#|Produces:/)
end

stages = stand_ins.map do |stand_in|
  stage = if copy.carries?(stand_in) then "landed"
          elsif upstream.carries?(stand_in) then "upstream"
          elsif stand_in.name && asks.any? { |ask| ask.match?(/\b#{Regexp.escape(stand_in.name)}\b/) } then "requested"
          else "unrequested"
          end
  puts format("%-12s %-16s %s:%d  %s", stage, stand_in.name || "?", stand_in.path, stand_in.line, stand_in.text)
  stage
end

exit(stages.all?("requested") ? 0 : 1)
